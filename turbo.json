{
	"$schema": "https://turborepo.dev/schema.json",
	"ui": "tui",

	"globalEnv": ["NODE_ENV"],

	"globalPassThroughEnv": [
		"DATABASE_URL",
		"DATABASE_URL_UNPOOLED",
		"BETTER_AUTH_SECRET",
		"BETTER_AUTH_URL",
		"ALLOWED_SIGN_IN",
		"GOOGLE_CLIENT_ID",
		"GOOGLE_CLIENT_SECRET",
		"MICROSOFT_CLIENT_ID",
		"MICROSOFT_CLIENT_SECRET",
		"MICROSOFT_TENANT_ID",
		"APP_URL",
		"API_INTERNAL_URL",
		"API_URL",
		"AUTH_COOKIE_DOMAIN",
		"CRON_SECRET",
		"REDIS_URL",
		"CACHE_TTL_MS",
		"PORT",
		"PRISMA_LOG_QUERIES",
		"PERPLEXITY_API_KEY",
		"RAPIDAPI_KEY",
		"GITHUB_TOKEN",
		"BLOB_READ_WRITE_TOKEN",
		"AI_GATEWAY_API_KEY",
		"VERCEL_OIDC_TOKEN",
		"VERCEL_PROJECT_ID",
		"VERCEL_TEAM_ID",
		"VERCEL_TOKEN",
		"WORKFLOW_POSTGRES_APPLICATION_MANAGED_SHUTDOWN",
		"WORKFLOW_POSTGRES_JOB_PREFIX",
		"WORKFLOW_POSTGRES_MAX_POOL_SIZE",
		"WORKFLOW_POSTGRES_URL",
		"WORKFLOW_POSTGRES_WORKER_CONCURRENCY",
		"AGENT_URL",
		"AGENT_BRIDGE_SECRET"
	],

	"tasks": {
		"topo": {
			"dependsOn": ["^topo"]
		},
		"build": {
			"dependsOn": ["^build"],
			"inputs": ["$TURBO_DEFAULT$", ".env*"],
			"outputs": [
				".next/**",
				"!.next/cache/**",
				"!.next/dev/**",
				"dist/**",
				".output/**"
			]
		},
		"workflow:bootstrap": {
			"cache": false
		},
		"lint": {
			"dependsOn": ["topo"]
		},
		"check-types": {
			"dependsOn": ["topo", "^build"]
		},
		"test": {
			"dependsOn": ["topo", "^build"]
		},
		"dev": {
			"cache": false,
			"persistent": true
		}
	}
}
