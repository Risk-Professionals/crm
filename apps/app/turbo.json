{
	"$schema": "https://turborepo.dev/schema.json",
	"extends": ["//"],
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"inputs": ["$TURBO_DEFAULT$", ".env*"],
			"outputs": [".next/**", "!.next/cache/**", "!.next/dev/**"],
			"passThroughEnv": [
				"AGENT_BRIDGE_SECRET",
				"AGENT_URL",
				"API_INTERNAL_URL",
				"API_URL",
				"APP_URL",
				"AUTH_COOKIE_DOMAIN",
				"BETTER_AUTH_SECRET",
				"BETTER_AUTH_URL",
				"DATABASE_URL",
				"IS_MARKETING"
			]
		},
		"check-types": {
			"dependsOn": ["$TURBO_EXTENDS$", "typegen"]
		},
		"typegen": {
			"inputs": ["app/**", "next.config.ts"],
			"outputs": [".next/types/**", "next-env.d.ts"],
			"passThroughEnv": ["API_INTERNAL_URL", "API_URL"]
		},
		"dev": {
			"cache": false,
			"persistent": true,
			"passThroughEnv": [
				"AGENT_BRIDGE_SECRET",
				"AGENT_URL",
				"API_INTERNAL_URL",
				"API_URL",
				"APP_URL",
				"AUTH_COOKIE_DOMAIN",
				"BETTER_AUTH_SECRET",
				"BETTER_AUTH_URL",
				"DATABASE_URL",
				"IS_MARKETING"
			]
		}
	}
}
